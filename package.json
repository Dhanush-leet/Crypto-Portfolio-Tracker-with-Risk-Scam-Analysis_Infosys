{
    "name": "crypto-portfolio-tracker-root",
    "version": "1.0.0",
    "scripts": {
        "start-frontend": "cd frontend && npm run dev",
        "start-backend": "cd backend && mvn spring-boot:run",
        "dev": "npm-run-all --parallel start-frontend start-backend",
        "install-all": "npm install --prefix frontend && mvn clean install -f backend/pom.xml"
    },
    "devDependencies": {
        "npm-run-all": "^4.1.5"
    }
}